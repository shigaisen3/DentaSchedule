# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto

# Explicitly treat common source/text types as text.
*.cs        text diff=csharp
*.csproj    text
*.sln       text
*.json      text
*.ts        text
*.tsx       text
*.js        text
*.css       text
*.html      text
*.md        text

# Binary assets — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text
*.woff      binary
*.woff2     binary
